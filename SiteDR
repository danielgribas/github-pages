        document.addEventListener('DOMContentLoaded', () => {
            const langModalOverlay = document.getElementById('language-modal-overlay');
            const mainCvContent = document.getElementById('main-cv-content');
            langModalOverlay.classList.add('active'); // Show modal on load

            const langButtons = langModalOverlay.querySelectorAll('button[data-lang]');
            
            langButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const selectedLang = button.getAttribute('data-lang');
                    setLanguage(selectedLang);
                    langModalOverlay.classList.remove('active');
                    mainCvContent.style.display = 'block';
                     // Re-initialize scrollspy after content is visible and language is set
                    setTimeout(changeNavOnScroll, 100); 
                });
            });

            document.getElementById('currentYear').textContent = new Date().getFullYear();

            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            if(mobileMenuButton && mobileMenu){
                mobileMenuButton.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }

            document.querySelectorAll('#mobile-menu a, header nav a.nav-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    if (link.closest('#mobile-menu')) {
                        if(mobileMenu) mobileMenu.classList.add('hidden');
                    }
                    const targetId = link.getAttribute('href');
                    if (targetId && targetId.startsWith('#')) {
                        e.preventDefault();
                        const targetElement = document.querySelector(targetId);
                        if (targetElement) {
                             targetElement.scrollIntoView({
                                 behavior: 'smooth',
                                 block: 'start' 
                             });
                        }
                    }
                });
            });
            
            window.addEventListener('scroll', changeNavOnScroll);
            // Initial check is deferred until language is set and content visible
        });

        function setLanguage(lang) {
            document.documentElement.lang = lang === 'pt' ? 'pt-PT' : lang; // Set html lang attribute
            const elementsToTranslate = document.querySelectorAll('[data-lang-key]');
            elementsToTranslate.forEach(element => {
                const key = element.getAttribute('data-lang-key');
                if (translations[lang] && translations[lang][key]) {
                    // For elements that might contain HTML like bold tags, use innerHTML
                    // For simple text, textContent is safer. Heuristic: if text includes '**' it might be markdown-like bold.
                    if ( (key.includes('Resp') && translations[lang][key].includes('**')) || key === 'hardSkill1' ) { // Example keys that might have bold
                         element.innerHTML = translations[lang][key].replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                    } else {
                        element.textContent = translations[lang][key];
                    }
                }
            });
            // Update page title separately
            document.title = translations[lang]?.pageTitle || "Interactive CV - Daniel Gotlieb Ribas";
        }
        
        const navLinks = document.querySelectorAll('header nav a.nav-link, #mobile-menu a.nav-link');
        const sections = document.querySelectorAll('main section');

        function changeNavOnScroll() {
            if (document.getElementById('main-cv-content').style.display === 'none') return; // Don't run if content not visible

            let index = sections.length;
            const header = document.querySelector('header');
            const headerHeight = header ? header.offsetHeight + 20 : 80; 

            while(--index >= 0 && window.scrollY + headerHeight < sections[index].offsetTop) {}
            
            navLinks.forEach((link) => link.classList.remove('active'));
            
            if(index >=0 ) { 
                const activeSectionId = sections[index].id;
                navLinks.forEach(link => {
                    if (link.getAttribute('href') === `#${activeSectionId}`) {
                        link.classList.add('active');
                    }
                });
            }
        }
